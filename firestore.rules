rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'tamudating1@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function canMessage(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid))
        && get(/databases/$(database)/documents/profiles/$(uid)).data.messagingApproved == true
        && get(/databases/$(database)/documents/profiles/$(uid)).data.profileApproved == true;
    }

    match /profiles/{uid} {
      // Only public dating profile fields belong here. Private account data is separate.
      allow read: if signedIn();
      allow create: if owns(uid)
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.photoUrls is list
        && request.resource.data.photoUrls.size() >= 2
        && !('messagingApproved' in request.resource.data)
        && !('profileApproved' in request.resource.data)
        && !('verified' in request.resource.data)
        && !('admin' in request.resource.data)
        && !('email' in request.resource.data);
      allow update: if (owns(uid)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['messagingApproved', 'profileApproved', 'verified', 'admin', 'email']))
        || isAdmin();
      allow delete: if owns(uid) || isAdmin();
    }

    match /privateUsers/{uid} {
      allow read, create, update, delete: if owns(uid) || isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.plan in ['intro', 'vip']
        && ((request.resource.data.plan == 'intro' && request.resource.data.amountKsh == 1000)
          || (request.resource.data.plan == 'vip' && request.resource.data.amountKsh == 3000))
        && request.resource.data.transactionCode is string
        && request.resource.data.transactionCode.size() >= 6
        && request.resource.data.transactionCode.size() <= 20
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['uid', 'transactionCode', 'plan', 'amountKsh', 'status', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberUids;
      }
      function bothMembersApproved(data) {
        return data.memberUids is list
          && data.memberUids.size() == 2
          && canMessage(data.memberUids[0])
          && canMessage(data.memberUids[1]);
      }
      allow read: if isAdmin() || isMember();
      allow create: if signedIn()
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid in request.resource.data.memberUids
        && bothMembersApproved(request.resource.data);
      allow update: if isAdmin() || (isMember()
        && request.resource.data.memberUids == resource.data.memberUids
        && bothMembersApproved(request.resource.data));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function approvedConversationMembers() {
          return signedIn()
            && request.auth.uid in parentConversation().memberUids
            && parentConversation().memberUids.size() == 2
            && canMessage(parentConversation().memberUids[0])
            && canMessage(parentConversation().memberUids[1]);
        }
        allow read: if isAdmin() || approvedConversationMembers();
        allow create: if approvedConversationMembers()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt']);
        allow update, delete: if isAdmin();
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open';
      allow read, update, delete: if isAdmin();
    }

    match /blocks/{blockId} {
      allow read, create, delete: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }
  }
}
